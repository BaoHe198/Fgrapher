# Placeholder values so `pnpm build` compiles in CI without real secrets.
# Used only by .github/workflows/ci.yml's build step — never loaded by
# the actual app in any real environment. Every third-party integration
# (Stripe/Cloudinary/Resend/Google OAuth) is left unset here since the
# app already no-ops gracefully without them (see docs/ARCHITECTURE.md
# §7) — only the variables src/lib/env.ts actually requires are set.
#
# DATABASE_URL/DIRECT_URL deliberately aren't here: sitemap.xml is
# statically generated at build time and genuinely queries the database
# (see src/app/sitemap.ts), so a fake/unreachable connection string
# would fail the build, not just skip a feature. ci.yml sets those two
# as job-level env vars instead, pointing at a real (if disposable)
# Postgres service container it spins up for this reason — see that
# workflow file.
NEXTAUTH_SECRET="ci-placeholder-secret-not-used-for-anything-real"
NEXTAUTH_URL="http://localhost:3000"
APP_ENV="development"
