# Copy to e2e/.env.test (gitignored) and point at a disposable Postgres —
# never dev or prod. See e2e/README.md for how to start one locally.
# Port 5433 is the Docker path (the container maps 5433 -> 5432 so it can
# coexist with a Postgres already on 5432). A Homebrew/native install runs
# on 5432 instead — change both lines to :5432 then. The safety guard
# checks the host and the database NAME, not the port.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/fgrapher_test"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/fgrapher_test"

NEXTAUTH_SECRET="e2e-test-secret-do-not-use-elsewhere"
# 3100, not 3000: Playwright starts its own production server there so it
# can never be confused with `next dev` on 3000 (see playwright.config.ts).
NEXTAUTH_URL="http://localhost:3100"
AUTH_TRUST_HOST="true"

# The suite signs in hundreds of times from 127.0.0.1, well past the
# production ceiling of 20 per IP / 8 per email per 10 minutes. Without
# these the run fails midway with CredentialsSignin, which looks exactly
# like a wrong password. See src/lib/auth.ts.
LOGIN_IP_RATE_LIMIT_MAX="100000"
LOGIN_EMAIL_RATE_LIMIT_MAX="1000"

# requireCronSecret() fails CLOSED outside NODE_ENV=development, and the
# e2e server runs a production build — so the cron specs need a real
# secret to send, not an absent one. See src/lib/auth-helpers.ts.
CRON_SECRET="e2e-cron-secret-do-not-use-elsewhere"

# The marketplace, billing and community feed all ship behind flags that
# default to off (src/lib/env.ts). Their specs were written for the
# features, not for the flag-off placeholder pages, so the suite turns
# them on — the point is to keep covering code that still exists and is
# meant to be switched on later, rather than delete the tests. Stripe
# itself stays unconfigured: marketplace.spec.ts and
# subscription-lifecycle.spec.ts assert the not-configured behaviour on
# purpose (see the comments at the top of each).
# BILLING_ENABLED stays OFF, matching production and CLAUDE.md's Stripe
# constraint. It is load-bearing for provider-onboarding.spec.ts: with
# billing off, /api/auth/register calls assignFreePlan and the chosen role
# is active immediately; with it on, the role waits for a subscription that
# can never arrive here. subscription-lifecycle.spec.ts skips itself
# instead of forcing the opposite setting on the whole suite.
BILLING_ENABLED="false"
MARKETPLACE_ENABLED="true"
SOCIAL_FEED_ENABLED="true"

# Left unset on purpose: STRIPE_SECRET_KEY, RESEND_API_KEY,
# CLOUDINARY_*. The suite is written to work with all three
# unconfigured (see e2e/README.md for what that means for coverage) —
# setting them changes which code paths the Stripe/marketplace tests
# exercise, so only add them deliberately.
