// prisma/schema.prisma
// Fgrapher — Social media booking & marketplace for photography/videography

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// AUTH & USERS
// ============================================================================

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  emailVerified           DateTime?
  passwordHash            String?
  firstName               String?
  lastName                String?
  username                String?   @unique
  avatar                  String?
  // Mirrors of firstName+lastName / avatar, required by @auth/prisma-adapter's
  // default field names for OAuth account creation
  name                    String?
  image                   String?
  coverImage              String?
  bio                     String?
  phone                   String?
  // Free-text display location — kept for backward compatibility with
  // existing rows and as a fallback while wardId coverage is still
  // HCMC-only (Prompt B8/B4). Prefer wardId for anything that needs real
  // filtering/sorting; location is display-only going forward.
  location                String?
  latitude                Float?
  longitude               Float?
  // Prompt B4/B8 — real administrative ward, sourced from the Ward table
  // (never hardcoded, per CLAUDE.md mục 9). Nullable: coverage starts with
  // Hồ Chí Minh's 168 wards only, so most non-HCMC users won't have one
  // yet, and existing rows predate this field entirely.
  wardId                  String?
  // Required at registration for the MODEL role (age gate — see
  // services/age-gate.ts), private, never displayed. Profile pages only
  // ever show a computed age RANGE, never this value or an exact age.
  dateOfBirth             DateTime? @db.Date
  // Provider-only: whether new booking requests are currently open.
  acceptingBookings       Boolean   @default(true)
  // Per-category email/in-app toggles, shaped like
  // Record<"bookingRequest"|"bookingConfirmed"|"bookingCancelled"|"bookingReminder"
  //   |"newMessage"|"newFollower"|"newReview"|"productUpdates"|"tips",
  //   { email: boolean, inApp: boolean }>. No dedicated table since this is a
  // single settings blob read/written as a whole, never queried by field.
  notificationPreferences Json?
  // Admin moderation
  isVerified              Boolean   @default(false)
  isSuspended             Boolean   @default(false)
  suspendedReason         String?
  suspendedUntil          DateTime?
  adminNotes              String?   @db.Text
  // Incremented each time an upload is AUTO_REJECTED by the content
  // scanner (see services/moderation.ts) — the 3-strikes policy documented
  // on /guidelines is enforced against this counter.
  violationPoints         Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  // Relations
  ward                     Ward?                     @relation(fields: [wardId], references: [id])
  roles                    UserRole[]
  accounts                 Account[] // OAuth accounts
  sessions                 Session[]
  profiles                 Profile[]
  posts                    Post[]
  comments                 Comment[]
  likes                    Like[]
  sentMessages             Message[]                 @relation("sender")
  receivedMessages         Message[]                 @relation("receiver")
  bookingsAsCustomer       Booking[]                 @relation("customer")
  bookingsAsProvider       Booking[]                 @relation("provider")
  reviews                  Review[]                  @relation("reviewer")
  receivedReviews          Review[]                  @relation("reviewed")
  products                 Product[]
  orders                   Order[]
  shopOrders               Order[]                   @relation("shopOrders")
  cartItems                CartItem[]
  following                Follow[]                  @relation("follower")
  followers                Follow[]                  @relation("following")
  notifications            Notification[]
  savedProfiles            SavedProfile[]
  payments                 Payment[]
  conversationParticipants ConversationParticipant[]
  consentRecords           ConsentRecord[]
  dataRequests             DataRequest[]

  @@index([wardId])
  // Both filtered on every admin dashboard load (getAdminOverview) and by
  // /admin/users' list/search — no index meant a sequential scan on both,
  // invisible on seed data but not at real scale.
  @@index([deletedAt])
  @@index([isSuspended])
  @@map("users")
}

// ============================================================================
// GEOGRAPHY (Prompt B4/B8) — real Vietnamese administrative units, never
// hardcoded in application code (CLAUDE.md mục 9). Seeded from
// prisma/data/hcmc-wards.ts, sourced verbatim from the post-2025-merger
// ward list the project owner supplied — coverage starts with Hồ Chí Minh
// only; other provinces are added the same way once their real ward data
// is available. Two-level (Province -> Ward) even though only one Province
// row exists today, so adding the next province is a seed change, not a
// schema change.
// ============================================================================

model Province {
  id        String   @id @default(cuid())
  // Slug, not an asserted GSO numeric code — the 2025 merger reassigned/
  // retired those and this project has no confirmed authoritative mapping
  // for the new boundaries yet.
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wards           Ward[]
  profiles        Profile[]
  serviceAreas    ProfileServiceArea[]
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]

  @@map("provinces")
}

model Ward {
  id         String   @id @default(cuid())
  provinceId String
  // Zero-padded sequence number from the source list (e.g. "001"), unique
  // within its province — not an official GSO ward code (see Province.code).
  code       String
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  province Province  @relation(fields: [provinceId], references: [id])
  users    User[]
  profiles Profile[]

  @@unique([provinceId, code])
  @@index([provinceId])
  @@map("wards")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================================
// COMPLIANCE (Luật Bảo vệ dữ liệu cá nhân 91/2025, Nghị định 356/2025) —
// see docs/guides/fgrapher-danh-gia-va-prompt-sua-doi.md Prompt B2 and
// CLAUDE.md's "Ràng buộc bắt buộc". This is infrastructure built to the
// technical spec in that source document — NOT confirmed by a lawyer to
// satisfy the real law. See docs/MVP_SCOPE.md.
// ============================================================================

enum ConsentPurpose {
  SERVICE // required to use the service at all — never optional
  MARKETING
  ANALYTICS
  // Required specifically to submit KYC/ID-verification documents (Prompt
  // B3) — separate from SERVICE because it covers a more sensitive class
  // of data (a government ID) that the rest of the app never touches.
  IDENTITY_VERIFICATION
}

// Every grant/revoke creates a NEW row — never updated in place — so the
// full consent history for a user/purpose is always reconstructable
// (who granted what, when, under which policy version, revoked when).
model ConsentRecord {
  id            String         @id @default(cuid())
  userId        String
  purpose       ConsentPurpose
  policyVersion String
  granted       Boolean
  grantedAt     DateTime?
  revokedAt     DateTime?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("consent_records")
}

// Loose targetType/targetId reference (not a Prisma relation) — matches
// the existing Report/AdminAction pattern in this schema, since an
// audited action can target several different model types. actorId is
// nullable for system/cron-triggered entries that have no human actor.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

enum DataRequestType {
  EXPORT
  DELETION
}

enum DataRequestStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

model DataRequest {
  id          String            @id @default(cuid())
  userId      String
  type        DataRequestType
  status      DataRequestStatus @default(PENDING)
  requestedAt DateTime          @default(now())
  completedAt DateTime?
  resultUrl   String?
  note        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([status, requestedAt])
  @@map("data_requests")
}

// ============================================================================
// ROLES & SUBSCRIPTIONS
// ============================================================================

enum Role {
  PHOTOGRAPHER
  VIDEOGRAPHER
  MAKEUP_ARTIST
  STUDIO
  CAMERA_SHOP
  // Booked BY photographers/videographers for shoots — the reverse
  // direction of the Customer -> Provider flow, same shape as
  // MAKEUP_ARTIST otherwise (portfolio, services, bookings; no products).
  MODEL
  CUSTOMER
  // Not selectable at registration — granted manually via
  // scripts/make-admin.ts. No subscription required.
  ADMIN
}

// Identity verification state for roles that need it (currently MODEL
// only). UNVERIFIED is the default for every role — most roles never move
// off it, since only MODEL's onboarding/publish flow reads this field.
enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      Role
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Identity verification — required for every provider role as of
  // Prompt B3 (docs/guides/fgrapher-danh-gia-va-prompt-sua-doi.md), not
  // just MODEL, per Luật Thương mại điện tử 122/2025's seller-verification
  // requirement. The three images live in a Cloudinary folder completely
  // separate from portfolio media, uploaded with delivery type
  // "authenticated" (see lib/cloudinary.ts's generateKycUploadSignature) —
  // *IdUrl/*SelfieUrl below are never public URLs, only Cloudinary
  // public_ids used to mint short-lived signed URLs on demand for admins
  // (see generateKycSignedUrl). idNumberHash stores only a SHA-256 hash of
  // the ID number (for duplicate detection) — the plaintext number is
  // never persisted anywhere. purgeAfter drives the daily cron
  // (/api/cron/purge-kyc-documents) that deletes the images 90 days after
  // verifiedAt; verificationStatus/verifiedAt/verifiedBy/idNumberHash are
  // kept forever as the audit trail even after the images themselves are
  // purged.
  verificationStatus          VerificationStatus @default(UNVERIFIED)
  verificationIdUrl           String?
  verificationIdPublicId      String?
  verificationIdBackUrl       String?
  verificationIdBackPublicId  String?
  verificationSelfieUrl       String?
  verificationSelfiePublicId  String?
  idNumberHash                String?
  purgeAfter                  DateTime?
  verifiedAt                  DateTime?
  verifiedBy                  String? // admin userId
  verificationRejectedReason  String?
  // Content policy acceptance (currently only collected at registration
  // for the MODEL role) — lives here rather than on Profile because
  // UserRole exists from the moment of registration; Profile rows are
  // only created later, lazily, when the user first edits their profile.
  contentGuidelinesAcceptedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription?

  @@unique([userId, role])
  // Powers the admin verification queue's sort/filter (oldest PENDING
  // first) without a full table scan.
  @@index([verificationStatus, createdAt])
  @@map("user_roles")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
  TRIALING
}

model Subscription {
  id                       String             @id @default(cuid())
  userRoleId               String             @unique
  stripeCustomerId         String?
  // Not @unique: a single checkout for multiple roles produces one Stripe
  // Subscription with multiple line items, so several Subscription rows
  // (one per UserRole) can legitimately share the same Stripe subscription
  // ID. userRoleId is the actual 1:1 invariant.
  stripeSubscriptionId     String?
  // The specific SubscriptionItem this role's price is billed under —
  // current_period_start/end and price live per-item on Stripe's side, not
  // on the parent Subscription, since Stripe API 2025-03-31.
  stripeSubscriptionItemId String?            @unique
  stripePriceId            String?
  plan                     String? // e.g., "basic", "pro"
  // "month" or "year" — mirrors the synced SubscriptionItem's Price
  // recurring.interval, since a role's monthly and yearly prices are
  // separate Stripe Price objects (see ROLE_PLANS).
  interval                 String             @default("month")
  status                   SubscriptionStatus @default(ACTIVE)
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  cancelAtPeriodEnd        Boolean            @default(false)
  // Set when a payment fails (status becomes PAST_DUE) — access stays
  // fully live until this passes, then the role is deactivated.
  graceEndsAt              DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  userRole UserRole @relation(fields: [userRoleId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// Records processed Stripe webhook event IDs so retried deliveries
// (Stripe resends on timeout/non-2xx) are no-ops instead of double-applying
// a state change.
model WebhookEvent {
  id        String   @id
  type      String
  processed Boolean  @default(false)
  payload   Json
  error     String?
  createdAt DateTime @default(now())

  @@map("webhook_events")
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  stripePaymentId String        @unique
  amount          Float
  currency        String
  status          PaymentStatus
  description     String?
  createdAt       DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

// ============================================================================
// PROFILES (role-specific data)
// ============================================================================

enum ProfileCategory {
  // Photography/Videography styles
  WEDDING
  PORTRAIT
  FASHION
  COMMERCIAL
  EVENT
  PRODUCT
  FOOD
  LANDSCAPE
  STREET
  DOCUMENTARY
  MUSIC_VIDEO
  CORPORATE
  REAL_ESTATE
  // Makeup styles
  BRIDAL
  EDITORIAL
  SFX
  NATURAL
  GLAM
  // Studio types
  INDOOR
  OUTDOOR
  ROOFTOP
  CYCLORAMA
  GREEN_SCREEN
  // Model types
  FASHION_MODEL
  COMMERCIAL_MODEL
  FITNESS_MODEL
  PORTRAIT_MODEL
  HAND_FOOT_MODEL
  PLUS_SIZE
  PETITE
  MATURE
  ALTERNATIVE
}

enum ExperienceLevel {
  NEW
  INTERMEDIATE
  EXPERIENCED
  PROFESSIONAL
}

model Profile {
  id                          String           @id @default(cuid())
  userId                      String
  role                        Role // which role this profile belongs to
  displayName                 String?
  description                 String?          @db.Text
  website                     String?
  instagram                   String?
  facebook                    String?
  tiktok                      String?
  // Pricing
  priceMin                    Float?
  priceMax                    Float?
  currency                    String           @default("VND")
  // Studio-specific
  address                     String?
  area                        Float? // square meters
  amenities                   String[] // e.g., ["wifi", "ac", "parking", "changing_room"]
  // Camera Shop specific
  shopName                    String?
  // Địa giới hành chính (Prompt B4) — where this specific role/profile is
  // based, distinct from User.wardId (the person's personal/account
  // location). A photographer could live in one province but run their
  // studio profile out of another. Nullable: existing profiles predate
  // this field and the onboarding flow (Prompt B4 VIỆC 3) that sets it.
  provinceId                  String?
  wardId                      String?
  // Provider explicitly takes bookings from anywhere in the country (e.g.
  // a videographer who flies to weddings nationwide), independent of
  // provinceId/wardId which is about where they're physically based.
  // Distinct from travelWilling above, which is MODEL-only and means "will
  // travel to a shoot location" (a much shorter-range, per-gig concept) —
  // this flag instead controls whether the profile appears in every
  // province's search results (services/search.ts), not just its own.
  servesNationwide            Boolean          @default(false)
  // Model-specific — all optional, self-reported, only used when role is
  // MODEL. Never displayed on the profile when unset (no placeholder
  // dashes — see docs/guides/fgrapher-prompts-batch-2.md §3a).
  height                      Int? // cm
  measurements                String? // free text, stays flexible (e.g. "34-26-36")
  hairColor                   String?
  eyeColor                    String?
  shoeSize                    String?
  experienceLevel             ExperienceLevel?
  travelWilling               Boolean          @default(false)
  agencyRepresented           Boolean          @default(false)
  agencyName                  String?
  // Safety (currently exercised by the MODEL role's profile editor — see
  // docs/guides/fgrapher-prompts-batch-2.md §3c; generic, not restricted
  // to MODEL at the schema level, matching how other role-specific fields
  // on this model work). Content guidelines acceptance lives on UserRole
  // instead — see that model's comment for why.
  hideExactLocation           Boolean          @default(false)
  // Withholds contactPhone/locationAddress from the other party on a
  // booking until Booking.depositPaid is set. No Stripe payment flow
  // exists for bookings today (only for marketplace orders) — until one
  // is built, depositPaid is a manual flag a provider sets by hand, not
  // an automatic payment gate. See the Booking field's comment.
  requireDepositBeforeContact Boolean          @default(false)
  // Meta
  isPublished                 Boolean          @default(false)
  viewCount                   Int              @default(0)
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  province     Province?            @relation(fields: [provinceId], references: [id])
  ward         Ward?                @relation(fields: [wardId], references: [id])
  categories   ProfileCategory[]
  services     Service[]
  media        ProfileMedia[]
  serviceAreas ProfileServiceArea[]

  @@unique([userId, role])
  @@index([role, isPublished])
  @@index([userId])
  // Prompt B4 VIỆC 6 — common browse-filter combinations.
  @@index([role, isPublished, provinceId])
  @@index([provinceId, priceMin])
  @@map("profiles")
}

// Prompt B4 VIỆC 1 — a provider can additionally serve provinces beyond
// where they're based (Profile.provinceId is the primary one; rows here
// are the extra ones they opted into during onboarding/settings).
// isPrimary duplicates Profile.provinceId as a ProfileServiceArea row when
// true, so "which provinces does this profile show up in" is always a
// single query over this table rather than a union with Profile.provinceId.
model ProfileServiceArea {
  profileId  String
  provinceId String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  province Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  @@id([profileId, provinceId])
  @@index([provinceId])
  @@map("profile_service_areas")
}

// Prompt B4 VIỆC 4 — "báo tôi khi có nhà cung cấp ở khu vực này": captured
// when a search in a province+role combination comes up empty/thin. No
// notification delivery exists yet (Resend is no-op — see CLAUDE.md's
// "Current phase" section); rows just accumulate for now as a signal of
// unmet demand per province, to review manually via `pnpm db:studio`.
model WaitlistEntry {
  id         String   @id @default(cuid())
  email      String
  provinceId String
  role       Role
  createdAt  DateTime @default(now())

  province Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  @@index([provinceId, role])
  @@map("waitlist_entries")
}

model ProfileMedia {
  id        String    @id @default(cuid())
  profileId String
  url       String
  publicId  String? // Cloudinary public ID
  type      MediaType
  title     String?
  order     Int       @default(0)
  width     Int?
  height    Int?
  createdAt DateTime  @default(now())

  // Content moderation (Prompt B5, docs/guides/
  // fgrapher-danh-gia-va-prompt-sua-doi.md) — see services/moderation.ts.
  // New rows default PENDING; the migration that added these columns
  // backfilled every pre-existing row to APPROVED so already-published
  // portfolios didn't disappear. rightsConfirmedAt is the timestamp of the
  // image-rights checkbox required before upload (Điều 32 Bộ luật Dân sự
  // 2015 — using someone's likeness requires their consent).
  moderationStatus  ModerationStatus @default(PENDING)
  moderationNote    String?
  moderatedBy       String? // admin userId
  moderatedAt       DateTime?
  rightsConfirmedAt DateTime?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, order])
  @@index([moderationStatus, createdAt])
  @@map("profile_media")
}

enum MediaType {
  IMAGE
  VIDEO
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  AUTO_REJECTED
}

// ============================================================================
// SERVICES & BOOKING
// ============================================================================

model Service {
  id          String   @id @default(cuid())
  profileId   String
  name        String
  description String?  @db.Text
  duration    Int // minutes
  price       Float
  currency    String   @default("VND")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile  Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([profileId])
  @@map("services")
}

model Availability {
  id        String   @id @default(cuid())
  userId    String
  dayOfWeek Int // 0=Sunday, 6=Saturday
  startTime String // "09:00"
  endTime   String // "17:00"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dayOfWeek])
  @@map("availabilities")
}

model BlockedDate {
  id     String   @id @default(cuid())
  userId String
  date   DateTime @db.Date
  reason String?

  // Both null = the whole day is blocked. Both set ("HH:MM") = only that
  // window is blocked — the rest of the day's weekly Availability windows
  // stay bookable. One row per date (see @@unique below), so a single date
  // can carry at most one whole-day block OR one time-range block, not
  // several disjoint ranges — a deliberate scope limit (Prompt F3, VIỆC 1).
  startTime String?
  endTime   String?

  @@unique([userId, date])
  @@map("blocked_dates")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  COMPLETED
  CANCELLED
  NO_SHOW
  // Prompt B7, VIỆC 2 — a PENDING booking the provider never responded to.
  // Set by the hourly /api/cron/expire-bookings cron, never by a user
  // action. Terminal, same as DECLINED/CANCELLED/NO_SHOW.
  EXPIRED
}

model Booking {
  id             String        @id @default(cuid())
  customerId     String
  providerId     String
  serviceId      String?
  date           DateTime      @db.Date
  startTime      String // "10:00"
  endTime        String? // "12:00"
  status         BookingStatus @default(PENDING)
  notes          String?       @db.Text
  totalPrice     Float?
  currency       String        @default("VND")
  cancelledBy    String? // userId of who cancelled
  cancelReason   String? // also used for decline/no-show reason
  completedAt    DateTime?
  reminderSentAt DateTime? // set once the 24h-out reminder cron has emailed both parties
  // Manually set by the provider — see Profile.requireDepositBeforeContact.
  // Not driven by any payment integration yet.
  depositPaid    Boolean       @default(false)
  // Prompt B7, VIỆC 2 — createdAt + 48h, set at creation. The hourly cron
  // moves any still-PENDING booking past this to EXPIRED.
  expiresAt      DateTime?

  locationType    String? // "PROVIDER" | "CUSTOMER" | "OUTDOOR"
  locationAddress String?
  numberOfPeople  Int?
  contactPhone    String?
  referenceImages String[] @default([])
  // Prompt B7, VIỆC 4 / Prompt B4 — the provider's Profile.provinceId at
  // booking-creation time (falling back to their personal User.wardId's
  // province if the profile hasn't set one yet — see services/bookings.ts).
  // Was a free-text string before Prompt B4 built the real Province model;
  // now a proper FK. Write-only today — nothing reads this yet, kept for
  // future province-scoped booking analytics/admin filtering.
  provinceId      String?

  // Crew-hire bookings (Prompt B7, VIỆC 1) — e.g. a Photographer books a
  // Model/Make-up Artist/Studio and attaches it to one of their own
  // ACCEPTED customer bookings. requesterRole/recipientRole are nullable
  // (not required, despite the source prompt's literal spec) because
  // backfilling them accurately for bookings that predate this field
  // would require guessing which of a multi-role provider's roles applied
  // to a specific past booking — every booking going forward always sets
  // both. IMPORTANT: cancelling a parent booking does NOT cascade to
  // cancel its children — see services/bookings.ts's transitionBooking,
  // which only notifies the child's provider so they can decide for
  // themselves; the MUA/Model/Studio already held that slot and
  // auto-cancelling would cost them the job through no fault of their own.
  parentBookingId String?
  requesterRole   Role?
  recipientRole   Role?

  // Reschedule proposal — either party can propose a new slot; the other
  // must accept/decline before it takes effect. Null when no proposal
  // is pending.
  rescheduleProposedDate      DateTime? @db.Date
  rescheduleProposedStartTime String?
  rescheduleProposedEndTime   String?
  rescheduleProposedBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer      User                   @relation("customer", fields: [customerId], references: [id])
  provider      User                   @relation("provider", fields: [providerId], references: [id])
  service       Service?               @relation(fields: [serviceId], references: [id])
  province      Province?              @relation(fields: [provinceId], references: [id])
  review        Review?
  parentBooking Booking?               @relation("crewHire", fields: [parentBookingId], references: [id])
  childBookings Booking[]              @relation("crewHire")
  statusHistory BookingStatusHistory[]

  @@index([customerId])
  @@index([providerId, status])
  @@index([date])
  @@index([parentBookingId])
  @@index([status, expiresAt])
  @@map("bookings")
}

// Prompt B7, VIỆC 3 — every status change made through
// services/bookings.ts's transitionBooking() (the ONLY place Booking.
// status is ever written) appends one row here. actorId is nullable for
// system-triggered transitions (the expire-bookings cron).
model BookingStatusHistory {
  id         String        @id @default(cuid())
  bookingId  String
  fromStatus BookingStatus
  toStatus   BookingStatus
  actorId    String?
  note       String?
  createdAt  DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("booking_status_history")
}

// ============================================================================
// SOCIAL FEED
// ============================================================================

model Post {
  id        String    @id @default(cuid())
  userId    String
  caption   String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  media    PostMedia[]
  likes    Like[]
  comments Comment[]

  @@index([userId, createdAt])
  @@map("posts")
}

model PostMedia {
  id       String    @id @default(cuid())
  postId   String
  url      String
  publicId String? // Cloudinary
  type     MediaType
  order    Int       @default(0)
  width    Int?
  height   Int?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, order])
  @@map("post_media")
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("likes")
}

model Comment {
  id        String    @id @default(cuid())
  userId    String
  postId    String
  content   String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@map("comments")
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

// ============================================================================
// MARKETPLACE (Camera Shop)
// ============================================================================

enum ProductType {
  SALE
  RENT
  BOTH
}

enum ProductCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
}

model Product {
  id            String           @id @default(cuid())
  userId        String // shop owner
  name          String
  description   String?          @db.Text
  category      String // camera, lens, lighting, accessory, etc.
  type          ProductType      @default(SALE)
  price         Float? // sale price
  rentalPrice   Float? // per day
  depositAmount Float? // rental deposit, refunded on return
  currency      String           @default("VND")
  condition     ProductCondition @default(NEW)
  stock         Int              @default(1)
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  images     ProductImage[]
  orderItems OrderItem[]
  cartItems  CartItem[]

  @@index([userId, isActive])
  @@index([category])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  publicId  String?
  order     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, order])
  @@map("product_images")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum DepositStatus {
  HELD
  REFUNDED
  DEDUCTED
}

model Order {
  id              String      @id @default(cuid())
  customerId      String
  // A cart can hold items from multiple shops, but every Order is split to
  // one shop at checkout (one Order + PaymentIntent per shop) — this is
  // also what Stripe Connect would have required anyway, so the data model
  // stays correct if Connect is wired up later.
  shopId          String
  status          OrderStatus @default(PENDING)
  totalPrice      Float
  currency        String      @default("VND")
  deliveryMethod  String? // SHIP | PICKUP
  shippingAddress String?     @db.Text
  trackingNumber  String?
  trackingCarrier String?
  cancelReason    String?
  notes           String?
  stripePaymentId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  customer User        @relation(fields: [customerId], references: [id])
  shop     User        @relation("shopOrders", fields: [shopId], references: [id])
  items    OrderItem[]

  @@index([customerId])
  @@index([shopId, status])
  @@map("orders")
}

model OrderItem {
  id            String         @id @default(cuid())
  orderId       String
  productId     String
  quantity      Int            @default(1)
  unitPrice     Float
  type          ProductType // SALE or RENT
  rentalStart   DateTime?
  rentalEnd     DateTime?
  depositAmount Float?
  depositStatus DepositStatus?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model CartItem {
  id          String      @id @default(cuid())
  userId      String
  productId   String
  quantity    Int         @default(1)
  type        ProductType // SALE or RENT
  rentalStart DateTime?   @db.Date
  rentalEnd   DateTime?   @db.Date
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, type, rentalStart, rentalEnd])
  @@map("cart_items")
}

// ============================================================================
// MESSAGING
// ============================================================================

model Conversation {
  id            String    @id @default(cuid())
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

// Per-participant read state (lastReadAt) — the plain participantIds
// String[] this replaces had no way to track "this user read up to when",
// which read receipts and unread counts both need.
model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, conversationId])
  @@map("conversation_participants")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  receiverId     String
  content        String    @db.Text
  type           String    @default("text") // text, image, booking_link
  mediaUrl       String?
  bookingId      String?
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("sender", fields: [senderId], references: [id])
  receiver     User         @relation("receiver", fields: [receiverId], references: [id])

  @@index([conversationId, createdAt])
  @@index([receiverId, readAt])
  @@map("messages")
}

model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@map("blocked_users")
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  DISMISSED
}

// HIGH is set at creation time for reasons that need immediate attention
// (currently "Inappropriate content" and "Appears to be a minor" — see
// REPORT_REASONS in src/lib/constants.ts and services/reports.ts).
enum ReportPriority {
  NORMAL
  HIGH
}

// A generic report — targetType/targetId is a loose reference (not a
// Prisma relation) since reports can point at several different models
// (review, user, message, product); admin tooling (Phase 12) resolves it.
model Report {
  id          String         @id @default(cuid())
  reporterId  String
  targetType  String // "review" | "user" | "message" | "product"
  targetId    String
  reason      String
  priority    ReportPriority @default(NORMAL)
  description String?        @db.Text
  status      ReportStatus   @default(PENDING)
  reviewedBy  String?
  reviewNote  String?
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@index([priority, status])
  @@map("reports")
}

// A loose (non-relational) audit trail of admin actions — targetType/
// targetId mirrors Report's pattern since admin actions can touch several
// different models (user, review, product, report...).
model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_actions")
}

// ============================================================================
// REVIEWS
// ============================================================================

model Review {
  id          String    @id @default(cuid())
  bookingId   String    @unique
  reviewerId  String
  reviewedId  String // provider being reviewed
  rating      Int // 1-5
  content     String?   @db.Text
  response    String?   @db.Text // provider response
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  booking  Booking @relation(fields: [bookingId], references: [id])
  reviewer User    @relation("reviewer", fields: [reviewerId], references: [id])
  reviewed User    @relation("reviewed", fields: [reviewedId], references: [id])

  @@index([reviewedId, rating])
  @@map("reviews")
}

// ============================================================================
// NOTIFICATIONS & MISC
// ============================================================================

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_CONFIRMED
  BOOKING_DECLINED
  BOOKING_CANCELLED
  BOOKING_REMINDER
  BOOKING_RESCHEDULE_PROPOSED
  BOOKING_COMPLETED
  NEW_MESSAGE
  NEW_FOLLOWER
  NEW_REVIEW
  NEW_LIKE
  NEW_COMMENT
  SUBSCRIPTION_ACTIVE
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_CANCELLED
  PAYMENT_FAILED
  NEW_ORDER
  ORDER_CONFIRMED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  REVIEW_RESPONSE
  MEDIA_APPROVED
  MEDIA_REJECTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json? // additional context (bookingId, postId, etc.)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model SavedProfile {
  id        String   @id @default(cuid())
  userId    String
  profileId String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, profileId])
  @@map("saved_profiles")
}
