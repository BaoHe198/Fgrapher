# App
NEXT_PUBLIC_APP_NAME="Fgrapher"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (Supabase PostgreSQL)
# Transaction-mode pooler — used by the app at runtime (IPv4-only, pgbouncer)
DATABASE_URL=""
# Session-mode pooler — used by Prisma Migrate
DIRECT_URL=""

# NextAuth.js
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Stripe (run `npx tsx --env-file=.env scripts/stripe-setup.ts` to create
# the Products/Prices and print the STRIPE_PRICE_* values below)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PHOTOGRAPHER=""
STRIPE_PRICE_VIDEOGRAPHER=""
STRIPE_PRICE_MAKEUP_ARTIST=""
STRIPE_PRICE_STUDIO=""
STRIPE_PRICE_CAMERA_SHOP=""

# Email
RESEND_API_KEY=""

# Cron (protects /api/cron/* routes — Vercel sends this as a Bearer token automatically)
CRON_SECRET=""
