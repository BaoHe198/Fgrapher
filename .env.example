# Fgrapher environment variables — complete template.
#
# Three environments use this same shape with different values: local
# development, staging (the `develop` branch / Vercel Preview), and
# production (the `master` branch / Vercel Production). See
# docs/ENVIRONMENTS.md for the full per-environment value table — this
# file just documents what each variable IS and where to get it.
#
# Local setup: copy this to BOTH .env (read by the Prisma CLI only) and
# .env.local (read by the Next.js app at runtime) — they need the same
# DATABASE_URL/DIRECT_URL in both. Staging/production values are never
# written to a file at all; they live only in Vercel's Environment
# Variables settings. Validated at build/startup by src/lib/env.ts —
# a missing required variable fails loudly instead of silently at
# request time.

# ---- App / environment identity ----
NEXT_PUBLIC_APP_NAME="Fgrapher"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# development | staging | production — separate from NODE_ENV. Drives the
# non-production environment banner, disables analytics outside
# production, and redirects outbound email to STAGING_TEST_INBOX on
# staging. See docs/ENVIRONMENTS.md.
APP_ENV="development"

# ---- Feature flags — "true" or "false" only, default false ----
# See src/lib/features.ts and docs/MVP_SCOPE.md. Stripe can't take a
# merchant account for a Vietnam-registered business (CLAUDE.md's
# "Ràng buộc bắt buộc" #1) — leave BILLING_ENABLED false; plans are
# assigned manually via /admin/users/[id] instead. Marketplace and the
# social feed are out of MVP scope.
BILLING_ENABLED="false"
MARKETPLACE_ENABLED="false"
SOCIAL_FEED_ENABLED="false"
# Local Vietnamese payment rails for provider subscription billing —
# independent of BILLING_ENABLED above (that one is Stripe-specific and
# stays off permanently, CLAUDE.md rule 1). Flip each on only once ready
# to actually charge — see src/services/payments.ts.
MOMO_ENABLED="false"
ZALOPAY_ENABLED="false"
BANK_TRANSFER_ENABLED="false"

# ---- Database (Supabase PostgreSQL) — REQUIRED ----
# Get both from: Supabase project → Connect (top bar) → ORM tab → Prisma
# Transaction-mode pooler — used by the app at runtime (IPv4-only, pgbouncer)
DATABASE_URL=""
# Session-mode pooler — used by Prisma Migrate
DIRECT_URL=""

# ---- NextAuth.js — REQUIRED ----
# NEXTAUTH_SECRET: any random 32+ char string (`openssl rand -base64 32`).
# Use a DIFFERENT value per environment — never share one between
# development/staging/production.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---- Google OAuth — optional (sign-in with Google is unavailable
# without it; every other auth path still works) ----
# Get from: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Cloudinary — optional (uploads no-op gracefully without it) ----
# Get from: Cloudinary dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Zalo Official Account — optional (the profile share menu's Zalo
# option simply doesn't render without it; every other share option still
# works) ----
# Get from: registering a Zalo OA at https://oa.zalo.me
NEXT_PUBLIC_ZALO_OA_ID=""

# ---- Stripe — dormant while BILLING_ENABLED=false (see above); optional
# even if re-enabled, since every call site no-ops gracefully without it ----
# Get STRIPE_SECRET_KEY / NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY from:
# Stripe Dashboard → Developers → API keys (test mode for dev/staging,
# live mode for production — never mix the two)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# From `stripe listen` locally, or Dashboard → Webhooks → your endpoint
# → Signing secret (a separate endpoint/secret per environment)
STRIPE_WEBHOOK_SECRET=""
# Run `npx tsx --env-file=.env scripts/stripe-setup.ts` to create the
# Products/Prices and print these — live-mode price IDs must be created
# separately in live mode, they are never inherited from test mode.
STRIPE_PRICE_PHOTOGRAPHER_MONTHLY=""
STRIPE_PRICE_PHOTOGRAPHER_YEARLY=""
STRIPE_PRICE_VIDEOGRAPHER_MONTHLY=""
STRIPE_PRICE_VIDEOGRAPHER_YEARLY=""
STRIPE_PRICE_MAKEUP_ARTIST_MONTHLY=""
STRIPE_PRICE_MAKEUP_ARTIST_YEARLY=""
STRIPE_PRICE_STUDIO_MONTHLY=""
STRIPE_PRICE_STUDIO_YEARLY=""
STRIPE_PRICE_CAMERA_SHOP_MONTHLY=""
STRIPE_PRICE_CAMERA_SHOP_YEARLY=""
STRIPE_PRICE_MODEL_MONTHLY=""
STRIPE_PRICE_MODEL_YEARLY=""

# ---- MoMo Payment Gateway — dormant while MOMO_ENABLED=false; optional
# even if re-enabled, src/lib/momo.ts no-ops gracefully without it ----
# Get from: registering a free developer account at developers.momo.vn —
# sandbox credentials are self-serve, production requires their merchant
# approval process. Never use sandbox keys in production or vice versa.
MOMO_PARTNER_CODE=""
MOMO_ACCESS_KEY=""
MOMO_SECRET_KEY=""

# ---- ZaloPay — dormant while ZALOPAY_ENABLED=false; optional even if
# re-enabled, src/lib/zalopay.ts no-ops gracefully without it ----
# Get from: registering a sandbox app at developers.zalopay.vn. key1
# signs outgoing requests, key2 verifies their incoming callback — do not
# mix them up, see src/lib/zalopay.ts's comment.
ZALOPAY_APP_ID=""
ZALOPAY_KEY1=""
ZALOPAY_KEY2=""

# ---- Bank transfer — dormant while BANK_TRANSFER_ENABLED=false ----
# Not secrets — shown directly to any customer choosing to pay this way.
# Manual: a customer transfers money outside the app, submits proof, and
# an admin confirms it at /admin/payments.
NEXT_PUBLIC_BANK_TRANSFER_ACCOUNT_NUMBER=""
NEXT_PUBLIC_BANK_TRANSFER_ACCOUNT_NAME=""
NEXT_PUBLIC_BANK_TRANSFER_BANK_NAME=""

# ---- Twilio Verify — optional (phone verification no-ops gracefully
# without it; see lib/sms.ts). Required before ServiceRequest creation
# (Prompt G7) can actually enforce its phone-verified-account rule — until
# configured, POST /api/phone/send-code returns a clear "not configured"
# error rather than silently succeeding. ----
# Get from: Twilio Console → Account → API keys & tokens (Account SID +
# Auth Token), and Verify → Services → create a Verify Service for its SID
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# ---- Email (Resend) — optional (emails no-op gracefully without it) ----
# Get from: Resend dashboard
RESEND_API_KEY=""
# Staging only: when set, every outbound email is redirected here
# instead of the real recipient (real API key, fake destination) — see
# lib/email.ts. Leave unset in development and production.
STAGING_TEST_INBOX=""

# ---- Cron — optional locally ----
# Protects /api/cron/* routes; Vercel sends this as a Bearer token
# automatically once set as a Vercel env var — generate like
# NEXTAUTH_SECRET, a different value per environment.
CRON_SECRET=""

# ---- Sentry (error tracking) — optional, no-ops without it ----
# Get from: sentry.io → Settings → Projects → [project] → Client Keys (DSN).
# Free "Developer" plan, no card required — see src/instrumentation.ts,
# src/instrumentation-client.ts, src/sentry.server.config.ts,
# src/sentry.edge.config.ts. Same value used client- and server-side (a
# Sentry DSN is meant to be public, unlike an API secret — it only
# identifies which project to send events to). Deliberately conservative
# data collection (no cookies/headers/request bodies/local variables sent
# — see src/lib/sentry-shared.ts) given this app handles KYC/personal data
# under CLAUDE.md's data-protection rules.
NEXT_PUBLIC_SENTRY_DSN=""
