{
  "name": "fgrapher",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "predb:migrate:dev": "node scripts/check-db-safety.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "predb:push": "node scripts/check-db-safety.mjs",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "predb:reset": "node scripts/check-db-safety.mjs",
    "db:reset": "prisma migrate reset",
    "test:e2e": "dotenv -e e2e/.env.test -- playwright test --project=e2e",
    "test:e2e:ui": "dotenv -e e2e/.env.test -- playwright test --project=e2e --ui",
    "test:smoke": "playwright test --project=smoke",
    "test:visual": "dotenv -e e2e/.env.test -- playwright test --project=visual-light --project=visual-dark",
    "test:visual:update": "dotenv -e e2e/.env.test -- playwright test --project=visual-light --project=visual-dark --update-snapshots",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.8.0",
    "@prisma/client": "^6.19.3",
    "@stripe/stripe-js": "^9.13.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.7",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-dropzone": "^20.1.0",
    "react-hook-form": "^7.85.0",
    "resend": "^6.20.0",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@auth/core": "0.41.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
